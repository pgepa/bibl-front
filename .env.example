# ==============================================================================
# SISBIB - BIBLIOTECA PGE-PA (FRONTEND) - MODELO DE CONFIGURAÇÃO (.env.example)
# ==============================================================================
# Instruções:
# 1. Copie este arquivo para ".env" no mesmo diretório:
#    cp .env.example .env
# 2. Preencha as variáveis abaixo com os valores do seu ambiente.
# ==============================================================================

# Porta do servidor Angular de desenvolvimento
PORT=4200

# Host de escuta
HOST=0.0.0.0

# URL da API do Backend (usado para proxy reverso ou ambiente de produção)
API_URL=http://localhost:8080

# Link externo do sistema SIEB institucional
SIEB_EXTERNAL_URL=http://esap.pge.pa.gov.br:5000/
